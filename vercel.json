{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/booking/success",
      "destination": "/launch-booking?payment=pending",
      "permanent": false
    },
    {
      "source": "/booking/cancel",
      "destination": "/launch-booking?payment=cancelled",
      "permanent": false
    },
    {
      "source": "/booking/cancelled",
      "destination": "/launch-booking?payment=cancelled",
      "permanent": false
    },
    {
      "source": "/booking/payment",
      "destination": "/launch-booking?payment=pending",
      "permanent": false
    },
    {
      "source": "/booking/return",
      "destination": "/launch-booking?payment=pending",
      "permanent": false
    },
    {
      "source": "/ponchopay/return",
      "destination": "/launch-booking?payment=pending",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/booking-lab",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/launch-booking",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/booking/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/ponchopay/return",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ponchopay/:event",
      "destination": "/api/ponchopay_event?event=:event"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
