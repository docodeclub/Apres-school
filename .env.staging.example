# Copy to .env.staging for hidden staging only. Do not commit real values.

# Public browser values for the hidden staging frontend.
BOOKING_STAGING_TARGET=hidden
SUPABASE_PROJECT_REF=
SUPABASE_FUNCTIONS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
VITE_BOOKING_PREVIEW_TOKEN=

# Server-side Supabase Edge Function secrets. Never expose these to Vercel/browser env.
APRES_SERVICE_ROLE_KEY=
PONCHOPAY_API_URL=
PONCHOPAY_CHECKOUT_PATH=/api/integration/generic/initiate
PONCHOPAY_INTEGRATION_KEY=
PONCHOPAY_PROCESSOR_TOKEN=
PONCHOPAY_WEBHOOK_SECRET=
PONCHOPAY_PROVIDER_ID=
PONCHOPAY_LOCATION_URN_DEFAULT=

# Public URLs and email routing for staging rehearsals.
PUBLIC_SITE_URL=https://www.apres-school.co.uk
STAFF_LOGIN_URL=https://www.apres-school.co.uk/staff-login
ENQUIRY_NOTIFICATION_TO=hello@apres-school.co.uk
OPERATIONS_NOTIFICATION_TO=hello@apres-school.co.uk
RESEND_API_KEY=
RESEND_FROM=Après School <hello@apres-school.co.uk>
APRES_EMAIL_FROM=Après School <hello@apres-school.co.uk>
APRES_BOOKING_EMAIL_FROM=Après School Bookings <hello@apres-school.co.uk>
APRES_STAFF_EMAIL_FROM=Après School Team <staff@apres-school.co.uk>
APRES_REPLY_TO=hello@apres-school.co.uk

# Guarded payment rehearsal. Leave disabled until the hidden staging deploy is ready.
PONCHOPAY_PENNY_TEST=
PONCHOPAY_PENNY_AMOUNT=0.01
PONCHOPAY_RUN_PROCESSOR=
PONCHOPAY_PROCESSOR_ONLY=
PONCHOPAY_SYNTHETIC_CALLBACKS=

# Guarded parent booking rehearsal. Requires a staging parent JWT and --run.
BOOKING_PARENT_REHEARSAL=
BOOKING_PARENT_ACCOUNT_REHEARSAL=
APRES_REHEARSAL_ADMIN_EMAIL=admin-account-rehearsal@apres-school.test
APRES_REHEARSAL_ADMIN_PASSWORD=
