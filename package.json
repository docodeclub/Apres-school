{
  "name": "apres-school-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "postbuild": "node scripts/prune-dist-assets.mjs && node scripts/create-spa-route-files.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "smoke": "node scripts/smoke-test.mjs",
    "qa:launch": "node scripts/launch-qa.mjs",
    "validate:static": "node scripts/static-check.mjs",
    "check:booking-links": "node scripts/audit-public-booking-links.mjs",
    "check:deploy": "node scripts/deploy-check.mjs",
    "check:deploy:strict": "node scripts/deploy-check.mjs --strict-env"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "playwright": "^1.54.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.3"
  }
}
